{
  "name": "dialysis-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "dev:admin": "vite --config vite.admin.config.ts",
    "build:admin": "vue-tsc -b && vite build --config vite.admin.config.ts",
    "smoke:admin": "node scripts/smoke-admin.mjs",
    "check:admin-dev": "node scripts/check-admin-dev.mjs",
    "verify:register": "node supabase/verify-register-guard.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "prepare": "node scripts/install-hooks.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:edge": "vitest run tests/edge",
    "verify": "npm run test && npm run build && npm run build:admin"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/preferences": "^6.0.4",
    "@capacitor/share": "^6.0.4",
    "@element-plus/icons-vue": "^2.3.2",
    "@supabase/supabase-js": "^2.112.3",
    "dexie": "^4.4.5",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.7",
    "html2canvas": "^1.4.1",
    "vant": "^4.10.0",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.2",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^5.0.3",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.2",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.8",
    "yaml": "^2.9.1"
  }
}
